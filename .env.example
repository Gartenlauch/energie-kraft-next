# Runtime
NEXT_PUBLIC_SITE_ENV=local
NEXT_PUBLIC_CANONICAL_BASE_URL=https://www.energie-kraft.de

# Firebase Emulator Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-energie-kraft-next.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-energie-kraft-next
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-energie-kraft-next.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199